<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODEL GATEWAY"
            android:textColor="@color/matrix_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="模型 API 接入"
            android:textColor="@color/matrix_primary_dark"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="配置仅保存在本机；API Key 使用 Android Keystore 加密。"
            android:textColor="@color/matrix_muted"
            android:textSize="13sp" />

        <TextView style="@style/MatrixFieldLabel" android:text="厂商/运行时" />
        <Spinner
            android:id="@+id/provider_spinner"
            style="@style/MatrixField"
            android:layout_height="52dp" />

        <TextView style="@style/MatrixFieldLabel" android:text="规划模式" />
        <Spinner
            android:id="@+id/planner_mode_spinner"
            style="@style/MatrixField"
            android:layout_height="52dp" />

        <TextView android:id="@+id/endpoint_label" style="@style/MatrixFieldLabel" android:text="Endpoint" />
        <EditText
            android:id="@+id/endpoint_input"
            style="@style/MatrixField"
            android:hint="完整 API Endpoint"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <TextView style="@style/MatrixFieldLabel" android:text="Model" />
        <EditText
            android:id="@+id/model_input"
            style="@style/MatrixField"
            android:hint="模型名称或 Endpoint ID"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView android:id="@+id/api_key_label" style="@style/MatrixFieldLabel" android:text="API Key" />
        <LinearLayout
            android:id="@+id/key_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="0dp">

            <EditText
                android:id="@+id/key_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="API Key（本地模型可留空）"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/matrix_text"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/key_visibility_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="显示或隐藏 API Key"
                android:src="@drawable/ic_eye_hidden" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/test_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/test_connection_button"
                style="@style/MatrixOutlineButton"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="测试连接" />

            <Button
                android:id="@+id/save_apply_button"
                style="@style/MatrixPrimaryButton"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="保存并应用" />
        </LinearLayout>

        <Button
            android:id="@+id/offline_button"
            style="@style/MatrixOutlineButton"
            android:text="切换为离线 DemoModelGateway" />

        <TextView
            android:id="@+id/api_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:fontFamily="monospace"
            android:minHeight="88dp"
            android:padding="12dp"
            android:textColor="@color/matrix_text"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Native Tool Calling 支持 OpenAI-Compatible 与 Anthropic；不支持 tools 的模型请显式选择 Structured JSON Compatibility。模拟器访问电脑本地模型使用 10.0.2.2。"
            android:textColor="@color/matrix_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
