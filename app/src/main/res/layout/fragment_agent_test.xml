<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGENT TEST"
            android:textColor="@color/matrix_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="任务闭环验证"
            android:textColor="@color/matrix_primary_dark"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/planner_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/matrix_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请求发起者"
                android:textColor="@color/matrix_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/actor_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="车辆档位 (gear=P 时 PARKED_ONLY 放行;gear=D 时拒绝车控写)"
                android:textColor="@color/matrix_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/gear_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/command_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:gravity="top|start"
            android:hint="例如：把主驾温度调到24度，然后导航回家"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="12dp"
            android:textColor="@color/matrix_text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/execute_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_primary"
            android:text="执行任务"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="快速测试"
            android:textColor="@color/matrix_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button android:id="@+id/quick_multi" style="@style/MatrixOutlineButton" android:text="多步任务" />
        <Button android:id="@+id/quick_context" style="@style/MatrixOutlineButton" android:text="上下文" />
        <Button android:id="@+id/quick_save" style="@style/MatrixOutlineButton" android:text="保存记忆" />
        <Button android:id="@+id/quick_read" style="@style/MatrixOutlineButton" android:text="读取记忆" />
        <Button android:id="@+id/quick_security" style="@style/MatrixOutlineButton" android:text="安全拒绝" />
        <Button android:id="@+id/quick_partial" style="@style/MatrixOutlineButton" android:text="部分失败" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/show_state_button"
                style="@style/MatrixOutlineButton"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="Mock 状态" />

            <Button
                android:id="@+id/clear_data_button"
                style="@style/MatrixOutlineButton"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="清空数据" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="任务轨迹"
            android:textColor="@color/matrix_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/output_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_card"
            android:fontFamily="monospace"
            android:minHeight="180dp"
            android:padding="12dp"
            android:textColor="@color/matrix_text"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
